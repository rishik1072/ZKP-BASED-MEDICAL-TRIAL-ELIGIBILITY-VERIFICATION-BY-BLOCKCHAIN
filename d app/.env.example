# DATABASE
DATABASE_URL=mongodb://localhost:27017/medical-zkp

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# RSA KEYS (base64 encoded)
RSA_PUBLIC_KEY=your_rsa_public_key
RSA_PRIVATE_KEY=your_rsa_private_key

# ENCRYPTION
ENCRYPTION_KEY=your_32_byte_hex_key_here
ENCRYPTION_ALGORITHM=aes-256-gcm

# BLOCKCHAIN
POLYGON_RPC_URL=https://polygon-rpc.com
PRIVATE_KEY_BLOCKCHAIN=your_private_key_for_blockchain
SMART_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_ID=137

# CIRCUIT & ZKP
CIRCUIT_WASM_PATH=../circuits/dist/eligibility_js/eligibility.wasm
CIRCUIT_ZKEY_PATH=../circuits/dist/eligibility_0001.zkey
VERIFYING_KEY_PATH=../circuits/dist/verification_key.json

# PUPPETEER (NMC Verification)
NMC_URL=https://nmc.gov.in
PUPPETEER_HEADLESS=true

# SERVER
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
